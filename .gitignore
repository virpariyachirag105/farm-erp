# ========================
# Environment & Secrets
# ========================
.env
.env.*
!.env.example

# ========================
# Python & Virtual Env
# ========================
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

